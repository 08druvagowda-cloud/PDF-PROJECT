# =====================================================================
# railway.json — Railway Deployment Configuration
#
# Deploy steps:
# 1. Push code to GitHub
# 2. Connect Railway to your repo at https://railway.app
# 3. Add a MySQL plugin (Railway provides DATABASE_URL automatically)
# 4. Set environment variable: SPRING_PROFILES_ACTIVE=prod
# 5. Railway will use this Dockerfile automatically
# =====================================================================
{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": null,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "healthcheckPath": "/api/templates",
    "healthcheckTimeout": 300
  }
}
